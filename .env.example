# GEMINI_API_KEY: Required for Gemini AI API calls (@google/genai).
# Configure via Settings > Secrets in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Optional PostgreSQL / Neon connection string for Prisma persistence.
# Format: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# When omitted, the app runs explicitly in MEMORY_DEMO mode (isPersisted=false).
DATABASE_URL=""

# N8N_WEBHOOK_URL & N8N_WEBHOOK_SECRET: Optional n8n Webhook configuration.
# Sends N8N_WEBHOOK_SECRET in the X-N8N-Webhook-Secret HTTP header (n8n Header Auth contract).
# Optional: set N8N_WEBHOOK_AUTH_MODE="HMAC" to also include X-AFI-Signature HMAC-SHA256.
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
N8N_WEBHOOK_AUTH_MODE="HEADER_AUTH"

# SESSION_SECRET: Required (>= 16 chars) for signed HttpOnly session cookies & CSRF protection.
SESSION_SECRET=""

# APP_ADMIN_PASSWORD & APP_ADMIN_EMAIL:
# APP_ADMIN_PASSWORD is only used to migrate/claim legacy admin access into an individual ADMIN account (or bootstrap with APP_ADMIN_EMAIL).
# Once the administrator migrates to an individual email+password ADMIN account, APP_ADMIN_PASSWORD can be removed from Secrets.
APP_ADMIN_PASSWORD=""
APP_ADMIN_EMAIL=""

# Optional Email Delivery Provider (not required unless enabling email verification & automated password reset):
# RESEND_API_KEY="" or SMTP_URL=""
# EMAIL_FROM="no-reply@suaempresa.com.br"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
